# Local development only. Copy to .env.local; it is loaded after .env, so
# these values win locally. Railway never reads this file.

# Servers and database (docker compose runs Postgres on 5433)
PORT=3000
DATABASE_URL=postgres://website:website@localhost:5433/website
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# GitHub OAuth app for local sign-in, separate from the production one.
# Its callback URL must be http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
