{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --experimental-strip-types --watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/app.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/app.ts",
    "typecheck": "tsc -p tfconfig.json",
    "premigrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-preflight.mjs",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js up -j ts -m src/migrations --check-order=false",
    "migrate:down": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js down -j ts -m src/migrations",
    "migrate:create": "node-pg-migrate create -j ts -m src/migrations --",
    "migrations:check": "node scripts/migrations-check.mjs",
    "test": "node --test --experimental-strip-types src/artefact-model.test.ts src/artefact-agent.test.ts src/artefact-snapshot.test.ts src/github.test.ts src/github-context.test.ts src/artefact-versions.test.ts src/artefact-access.test.ts src/live-status.test.ts src/artefact-recipes.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.6.0"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@better-auth/infra": "^0.4.10",
    "@sparticuz/chromium": "^153.0.0",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
